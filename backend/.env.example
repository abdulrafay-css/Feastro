# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# MONGODB
# ============================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/feastro

# MongoDB Atlas (Production - FREE FOREVER)
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/feastro?retryWrites=true&w=majority

# ============================================
# JWT
# ============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-please
JWT_EXPIRES_IN=30d

# ============================================
# AWS S3
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_VIDEOS=feastro-videos
AWS_S3_BUCKET_IMAGES=feastro-images

# CloudFront CDN (Optional)
CLOUDFRONT_URL=

# ============================================
# FRONTEND (CORS)
# ============================================
FRONTEND_URL=http://localhost:5173

# Production
# FRONTEND_URL=https://master.d1d831xsght4ak.amplifyapp.com

# ============================================
# FILE UPLOAD LIMITS
# ============================================
MAX_VIDEO_SIZE=104857600
MAX_IMAGE_SIZE=5242880

# ============================================
# OPTIONAL: PYTHON AI SERVICE
# ============================================
AI_SERVICE_URL=http://localhost:8000